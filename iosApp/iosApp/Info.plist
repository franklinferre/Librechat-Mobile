<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- The UI strings live in Compose resources, so iOS only learns the app speaks these languages
	     from this list. Without it NSLocale.currentLocale pins the language to English (en_BR on a
	     Brazilian device), which sends Auto-detect dictation to the English recognizer and leaves
	     system prompts in English. Keep in step with the composeResources values-* folders. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>ja</string>
		<string>ko</string>
		<string>pt</string>
		<string>ru</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>LID.IA</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Literal, not $(PRODUCT_NAME) — that resolves to the Xcode target name "iosApp".
	     Renaming the target instead would break release.yml's -scheme/-archivePath. -->
	<key>CFBundleName</key>
	<string>LID.IA</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Overwritten at build time by the "Stamp Version from version.properties"
	     build phase (which takes the processed copy of this file as an input, so it
	     runs after Xcode copies it); version.properties is the single source of truth. These
	     literals are just a sane fallback snapshot. CFBundleShortVersionString
	     carries only the numeric calver core (App Store Connect rejects
	     suffixes like -rc1 there); SwitchboardVersionName carries the full
	     versionName, and is what AppInfo.versionName displays. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.3</string>
	<key>CFBundleVersion</key>
	<string>103</string>
	<key>SwitchboardVersionName</key>
	<string>0.1.3</string>
	<!-- Overwritten at build time by the "Stamp Git SHA" build phase. AppInfo.gitSha reads this
	     key; the "unknown" literal is the fallback when there's no git checkout. -->
	<key>GitSHA</key>
	<string>unknown</string>
	<!-- The distribution channel (DistributionChannel wire name), from the SWITCHBOARD_CHANNEL
	     build setting: oss for Debug/Release, appstore for Release-AppStore. AppInfo.channel
	     refuses to start without a known value. -->
	<key>SwitchboardChannel</key>
	<string>$(SWITCHBOARD_CHANNEL)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app only uses the OS's standard TLS (HTTPS) — exempt encryption under App
	     Store export-compliance rules. Declaring it here answers the compliance
	     question once, so App Store Connect never holds an upload on a manual prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Background tasks: cache warming (`fetch` and `processing`, registered in
	     PrefetchBackgroundTasks.swift) and the schedule check (a `fetch` task, ScheduleCheckTask.swift).
	     iOS silently refuses to register an identifier absent from BGTaskSchedulerPermittedIdentifiers,
	     so these must match IosPrefetchTasks in :core:data and IosScheduleCheckTask in :core:notifications. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.garfiec.librechat.prefetch.refresh</string>
		<string>com.garfiec.librechat.prefetch.processing</string>
		<string>com.garfiec.librechat.schedules.check</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>LID.IA needs microphone access for voice input to transcribe speech to text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>LID.IA uses speech recognition to convert your voice into text messages.</string>
	<key>NSCameraUsageDescription</key>
	<string>LID.IA needs camera access to take photos for sharing in conversations.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LID.IA needs photo library access to share images in conversations.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>liderichat</string>
			</array>
		</dict>
	</array>
	<!-- canOpenURL() answers false for any scheme not listed here, so 2FA enrollment could not
	     detect an installed authenticator without this entry. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>otpauth</string>
	</array>
</dict>
</plist>
